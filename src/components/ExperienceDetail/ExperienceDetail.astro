---
import type { Experience } from "../../types/experiences"
import type { ShowcaseDetailListItem } from "../../types/showcase"
import { showcaseDetailContent } from "../../config/showcase-detail-content"
import ShowcaseDetailList from "../ShowcaseDetailList/ShowcaseDetailList.astro"
import ShowcaseDetail from "../ShowcaseDetail/ShowcaseDetail.astro"

type Props = {
    experience: Experience
}

const { experience } = Astro.props
const details = showcaseDetailContent.experiences.details.map(({ label, value }) => ({
    label,
    value: value(experience),
})) satisfies readonly ShowcaseDetailListItem[]
---
<ShowcaseDetail
    backHref={showcaseDetailContent.experiences.backLink.href}
    backLabel={showcaseDetailContent.experiences.backLink.label}
    title={experience.title}
    summary={experience.summary}
    cover={experience.cover}
    tags={experience.tags}
> 
    <ShowcaseDetailList
        slot="details"
        items={details}
    />
    <slot />
</ShowcaseDetail>
