---
import type { Experience } from "../../types/experiences"
import type { ShowcaseDetailListItem } from "../../types/showcase"
import { getRoutePath } from "../../config/routes"
import ShowcaseDetailList from "../ShowcaseDetailList/ShowcaseDetailList.astro"
import ShowcaseDetailLayout from "../ShowcaseDetailLayout/ShowcaseDetailLayout.astro"

type Props = {
    experience: Experience
}

const { experience } = Astro.props

const details = [
    {
        label: "Organisation",
        value: experience.organization,
    },
    {
        label: "Lieu",
        value: experience.location,
    },
    {
        label: "Période",
        value: [experience.startedAt, experience.endedAt].filter(Boolean).join(" - "),
    },
] satisfies readonly ShowcaseDetailListItem[]

---

<ShowcaseDetailLayout
    backHref={getRoutePath("experiences")}
    backLabel="Toutes les expériences"
    title={experience.title}
    summary={experience.summary}
    cover={experience.cover}
> 
    <ShowcaseDetailList
        slot="details"
        items={details}
    />
    <slot />
</ShowcaseDetailLayout>
