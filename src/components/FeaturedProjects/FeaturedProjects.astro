---
import { projects, getProjectUrl } from "../../config/projects"
import { showcaseFeaturedContent } from "../../config/showcase-featured-content"
import Section from "../Section/Section.astro"
import ShowcaseGrid from "../ShowcaseGrid/ShowcaseGrid.astro"
import ShowcaseCard from "../ShowcaseCard/ShowcaseCard.astro"

const featuredProjects = projects
  .filter((project) => project.featured)
const isTruncated = featuredProjects.length < projects.length
---
<Section
    targetId={showcaseFeaturedContent.projects.targetId}
    title={showcaseFeaturedContent.projects.title}
    summary={showcaseFeaturedContent.projects.summary}
    moreLink={showcaseFeaturedContent.projects.moreLink}
>
    <ShowcaseGrid isTruncated={isTruncated}>
        {featuredProjects.map((project) => (
          <ShowcaseCard
            href={getProjectUrl(project)}
            cover={project.cover}
            title={project.title}
            summary={project.summary}
            tags={project.tags}
            action={{
              ...showcaseFeaturedContent.projects.action,
              variant: "primary"
            }}
          />
        ))}
    </ShowcaseGrid>
</Section>
