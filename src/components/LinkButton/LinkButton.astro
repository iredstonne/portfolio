---
import type { HTMLAttributes } from "astro/types"
import classes from "./LinkButton.module.scss"

export type LinkButtonVariant = "primary" | "secondary" | "ghost"

export type Props = HTMLAttributes<"a"> & {
    variant: LinkButtonVariant
}

type AnchorHref = Props["href"]

const isExternalHref = (href: AnchorHref) => href && new URL(href, Astro.url).origin !== Astro.url.origin

const {
    variant,
    href,
    class: className,
    ...props
} = Astro.props
---
<a
    {...props}
    class:list={[classes.LinkButton, classes[`LinkButton--${variant}`], className]}
    href={href}
    {...isExternalHref(href) ? { 
        target: "_blank", 
        rel: "noopener noreferrer" 
    } : {}}
>
    <slot />
</a>
