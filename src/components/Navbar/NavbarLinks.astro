---
import clsx from "clsx"
import { navbarLinks } from "../../config/navbar-links"
import NavbarLink from "./NavbarLink.astro"
import classes from "./NavbarLinks.module.scss"

const normalizePathname = (pathname: string) =>
  pathname.replace(/\/+$/, "") || "/"

const pointsToCurrentPage = (url: URL) =>
  url.origin === Astro.url.origin &&
  normalizePathname(url.pathname) === normalizePathname(Astro.url.pathname)

const resolvedNavbarLinks = navbarLinks.map((navbarLink) => ({
  ...navbarLink,
  resolvedUrl: new URL(navbarLink.href, Astro.url)
}))

const navbarSamePageTargetLinkStyles = resolvedNavbarLinks
  .flatMap(({ resolvedUrl, href }) => {
    if (pointsToCurrentPage(resolvedUrl)) {
      const { hash } = resolvedUrl
      const targetId = decodeURIComponent(hash.slice(1))
      const targetScope = targetId ? `body:has([id="${targetId}"]:target)` : ''
      const targetSelector = clsx(targetScope, `.${classes.NavbarLinks}`, `a[href="${href}"]`)
      return `${targetSelector} { text-decoration-color: currentColor; }`
    }
    return []
  })
  .join("\n")

---

<div class={classes.NavbarLinks}>
  {resolvedNavbarLinks.map(({ href, label }) => (
    <NavbarLink
      href={href}
      label={label}
    />
  ))}
</div>

{navbarSamePageTargetLinkStyles.length > 0 && (
  <style is:inline set:html={navbarSamePageTargetLinkStyles} />
)}
