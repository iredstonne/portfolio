---
import type { Project } from "../../types/projects"
import type { ShowcaseDetailListItem } from "../../types/showcase"
import { showcaseDetailContent } from "../../config/showcase-detail-content"
import ShowcaseDetailList from "../ShowcaseDetailList/ShowcaseDetailList.astro"
import ShowcaseDetail from "../ShowcaseDetail/ShowcaseDetail.astro"

type Props = {
    project: Project
}

const { project } = Astro.props
const details = showcaseDetailContent.projects.details.map(({ label, value }) => ({
    label,
    value: value(project),
})) satisfies readonly ShowcaseDetailListItem[]
---
<ShowcaseDetail
    backHref={showcaseDetailContent.projects.backLink.href}
    backLabel={showcaseDetailContent.projects.backLink.label}
    title={project.title}
    summary={project.summary}
    cover={project.cover}
    tags={project.tags}
>
    <ShowcaseDetailList
        slot="details"
        items={details}
    />
    <slot />
</ShowcaseDetail>
