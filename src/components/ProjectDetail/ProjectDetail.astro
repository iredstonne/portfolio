---
import type { Project, ProjectStatus } from "../../types/projects"
import type { ShowcaseDetailListItem } from "../../types/showcase"
import { site } from "../../config/site"
import ShowcaseDetailList from "../ShowcaseDetailList/ShowcaseDetailList.astro"
import ShowcaseDetailLayout from "../ShowcaseDetailLayout/ShowcaseDetailLayout.astro"

type Props = {
    project: Project
}

const { project } = Astro.props

const statusLabels: Record<ProjectStatus, string> = {
    "planned": "Planifié",
    "in-progress": "En cours",
    "completed": "Terminé",
    "paused": "En pause",
}

const details = [
    {
        label: "État",
        value: statusLabels[project.status],
    },
    {
        label: "Période",
        value: [project.startedAt, project.endedAt].filter(Boolean).join(" - "),
    },
] satisfies readonly ShowcaseDetailListItem[]

---

<ShowcaseDetailLayout
    backHref={`${site.base}/projects`}
    backLabel="Tous les projets"
    title={project.title}
    summary={project.summary}
    cover={project.cover}
    tags={project.technologies}
    tagsLabel="Technologies utilisées"
>
    <ShowcaseDetailList
        slot="details"
        items={details}
    />
    <slot />
</ShowcaseDetailLayout>
