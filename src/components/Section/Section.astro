---
import type { HTMLAttributes } from "astro/types"
import classes from "./Section.module.scss"
import { arrowRightIcon, renderIconDefinitionToHTML } from "../../assets/icons"

type SectionMoreLink = {
    label: string
    href: string
}

type Props = HTMLAttributes<"section"> & {
    targetId: string
    title: string
    summary?: string
    moreLink?: SectionMoreLink
}

const {
    targetId,
    title,
    summary,
    moreLink,
    class: className,
    ...props
} = Astro.props
---
<section {...props} class:list={[classes.Section, className]} id={targetId}>
    <header class={classes.Section__header}>
        <h1 class={classes.Section__title}>{title}</h1>
        {summary && <p class={classes.Section__description}>{summary}</p>}
    </header>
    <slot />
    {moreLink && (
        <footer class={classes.Section__footer}>
            <a href={moreLink.href} class={classes.Section__link}>
                {moreLink.label}
                <span class={classes.Section__link__icon}>
                    <Fragment set:html={renderIconDefinitionToHTML(arrowRightIcon)} />
                </span>
            </a>
        </footer>
    )}
</section>
