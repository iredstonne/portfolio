---
import type { HTMLAttributes } from "astro/types"
import { ShowcaseCover } from "../../types/showcase"
import LinkButton, { LinkButtonVariant } from "../LinkButton/LinkButton.astro"
import classes from "./ShowcaseCard.module.scss"

export type Props = HTMLAttributes<"article"> & {
    href: string
    cover?: ShowcaseCover
    title: string
    summary: string
    tags?: readonly string[]
    action: {
        variant: LinkButtonVariant,
        label: string
    }
}

const {
    href,
    cover,
    title,
    summary,
    tags,
    action,
    class: className,
    ...props
} = Astro.props
---
<article {...props} class:list={[classes.ShowcaseCard, className]}>
    {cover && (
        <figure class={classes.ShowcaseCard__media}>
            <img 
                src={cover.src} 
                alt={cover.alt}
                class={classes.ShowcaseCard__image} 
                draggable="false"
                loading="eager"
            />
        </figure>
    )}
    <div class={classes.ShowcaseCard__body}>
        <h2 class={classes.ShowcaseCard__title}>{title}</h2>
        {summary && <p class={classes.ShowcaseCard__summary}>{summary}</p>}
    </div>
    <div class={classes.ShowcaseCard__footer}>
        {tags && tags.length > 0 && (
            <ul class={classes.ShowcaseCard__tags} aria-label="Tags">
                {tags.map((tag) => (
                    <li class={classes.ShowcaseCard__tag}>{tag}</li>
                ))}
            </ul>
        )}
        <LinkButton
            href={href}
            variant={action.variant}
            class={classes.ShowcaseCard__action}
        >
            {action.label}
        </LinkButton>
    </div>
</article>
