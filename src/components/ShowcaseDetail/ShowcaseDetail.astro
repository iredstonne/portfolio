---
import type { HTMLAttributes } from "astro/types"
import type { ShowcaseCover } from "../../types/showcase"
import { arrowLeftIcon, renderIconDefinitionToHTML } from "../../assets/icons"
import classes from "./ShowcaseDetail.module.scss"

type Props = HTMLAttributes<"article"> & {
    backHref: string
    backLabel: string
    title: string
    summary: string
    cover?: ShowcaseCover
    tags?: readonly string[]
}

const {
    backHref,
    backLabel,
    title,
    summary,
    cover,
    tags,
    class: className,
    ...props
} = Astro.props
---
<article {...props} class:list={[classes.ShowcaseDetail, className]}>
    <a
        class={classes.ShowcaseDetail__link}
        href={backHref}
    >
        <span class={classes.ShowcaseDetail__icon}>
            <Fragment set:html={renderIconDefinitionToHTML(arrowLeftIcon)} />
        </span>
        {backLabel}
    </a>
    <header class={classes.ShowcaseDetail__header}>
        <figure class={classes.ShowcaseDetail__media}>
            {cover && (
                <img
                    class={classes.ShowcaseDetail__image}
                    src={cover.src}
                    alt={cover.alt}
                    draggable="false"
                    loading="eager"
                />
            )}
        </figure>
        <div class={classes.ShowcaseDetail__overview}>
            <h1 class={classes.ShowcaseDetail__title}>{title}</h1>
            <p class={classes.ShowcaseDetail__summary}>{summary}</p>
            {Astro.slots.has("details") && (
                <div class={classes.ShowcaseDetail__details}>
                    <slot name="details" />
                </div>
            )}
            {tags && tags.length > 0 && (
                <ul class={classes.ShowcaseDetail__tags}>
                    {tags.map((tag) => (
                        <li class={classes.ShowcaseDetail__tag}>{tag}</li>
                    ))}
                </ul>
            )}
        </div>
    </header>
    <slot />
</article>
