---
import type { JsonLdDocument } from "../types/structured-data"
import Navbar from "../components/Navbar/Navbar.astro"
import DocumentMetadata from "../components/DocumentMetadata/DocumentMetadata.astro"
import { site } from "../config/site"
import baselineCss from "../styles/baseline.scss?inline"
import "../styles/global.scss"

type Props = {
  pageName?: string
  description?: string
  canonicalURL?: URL
  noRobots?: boolean
  structuredData?: JsonLdDocument
}

const {
  canonicalURL,
  noRobots = false,
  pageName,
  description = site.description,
  structuredData,
} = Astro.props

const siteName = site.name
const title = pageName
  ? `${pageName} • ${siteName}`
  : siteName
---
<!doctype html>
<html lang={site.language}>
  <head>
    <DocumentMetadata
      canonicalURL={canonicalURL}
      noRobots={noRobots}
      title={title}
      description={description}
      structuredData={structuredData}
    />
    <style is:inline set:html={baselineCss} />
  </head>
  <body>
    <header>
      <Navbar />
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
