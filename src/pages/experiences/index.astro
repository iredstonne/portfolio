---
import { experiences, getExperienceUrl } from "../../config/experiences"
import { showcaseCardContent } from "../../config/showcase-card-content"
import { showcaseCollectionContent } from "../../config/showcase-collection-content"
import ShowcaseCollectionLayout from "../../layouts/ShowcaseCollectionLayout.astro"
---
<ShowcaseCollectionLayout
    {...showcaseCollectionContent.experiences}
    cardAction={showcaseCardContent.experiences.action}
    items={experiences.map((experience) => ({
        item: new URL(getExperienceUrl(experience), Astro.site).href,
        name: experience.title,
        cover: experience.cover,
        summary: experience.summary,
        tags: experience.tags,
    }))}
/>
