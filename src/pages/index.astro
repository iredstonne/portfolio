---
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero/Hero.astro"
import FeaturedExperiences from "../components/FeaturedExperiences/FeaturedExperiences.astro"
import FeaturedProjects from "../components/FeaturedProjects/FeaturedProjects.astro"
import {
    personStructuredData,
    site,
    websiteStructuredData,
} from "../config/site"
import {
    createProfilePage,
    defineStructuredData,
} from "../lib/structured-data"

const description = site.description
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const structuredData = defineStructuredData(createProfilePage({
    url: canonicalURL,
    name: site.name,
    description: site.description,
    inLanguage: site.language,
    isPartOf: websiteStructuredData,
    mainEntity: personStructuredData,
}))
---

<BaseLayout
    canonicalURL={canonicalURL}
    description={description}
    structuredData={structuredData}
>
    <Hero />
    <div class="new-page">
        <FeaturedProjects />
    </div>
    <div class="new-page">
        <FeaturedExperiences />
    </div>
</BaseLayout>
