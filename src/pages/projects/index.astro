---
import ShowcaseCollectionLayout from "../../layouts/ShowcaseCollectionLayout.astro"
import { projects, getProjectUrl } from "../../config/projects"
import { showcaseCardContent } from "../../config/showcase-card-content"
import { showcaseCollectionContent } from "../../config/showcase-collection-content"
---
<ShowcaseCollectionLayout
    {...showcaseCollectionContent.projects}
    cardAction={showcaseCardContent.projects.action}
    items={projects.map((project) => ({
        item: new URL(getProjectUrl(project), Astro.site).href,
        name: project.title,
        cover: project.cover,
        summary: project.summary,
        tags: project.tags,
    }))}
/>
